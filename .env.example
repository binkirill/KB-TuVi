# Sao chép file này thành .env để chạy thử ở máy cá nhân (KHÔNG commit file .env lên GitHub!)

# Lấy miễn phí tại: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model Free Tier mặc định (gemini-3.8-flash | gemini-3.6-flash | gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.8-flash

# (Tùy chọn) Mật khẩu chia sẻ cho bạn bè khi dùng API Key chung của chủ web. Để trống nếu muốn mở tự do.
ACCESS_CODE=

# Giới hạn số lượt gọi AI mỗi ngày cho mỗi địa chỉ IP (để tránh hết quota free)
DAILY_LIMIT_PER_IP=20
