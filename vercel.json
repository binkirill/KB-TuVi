{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/*.py": {
      "maxDuration": 60,
      "includeFiles": "{assets,references,scripts}/**"
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/index.py"
    },
    {
      "source": "/assets/gemini_ai_addon.js",
      "destination": "/api/addon.py"
    },
    {
      "source": "/sdk/numerology.js",
      "destination": "/api/sdk-numerology.py"
    },
    {
      "source": "/api/name-check",
      "destination": "/api/name_check.py"
    }
  ]
}
